{
  "model": "Habit",
  "中文名称": "习惯",
  "version": "1.0",
  "description": "习惯追踪模型，承载习惯定义、身份声明、执行意图与连续打卡统计。",
  "note": "v1.0 字段以飞书真实表「习惯追踪表」为准；enum options 为初版，待与飞书实表对齐。",
  "source_skill": [
    "习惯管理系统"
  ],
  "feishu_table": {
    "id": "tblSRdG4P3XE75Ll",
    "name": "习惯追踪表"
  },
  "fields": [
    { "name": "name", "中文名称": "习惯名称", "type": "text", "required": true },
    { "name": "status", "中文名称": "状态", "type": "enum", "options": ["进行中", "已暂停", "已养成", "已放弃"] },
    { "name": "frequency", "中文名称": "频率", "type": "enum", "options": ["每日", "每周", "工作日", "自定义"] },
    { "name": "identity", "中文名称": "身份声明", "type": "text", "note": "原子习惯法：我想成为谁" },
    { "name": "execution_intent", "中文名称": "执行意图", "type": "text", "note": "时间+地点+行为" },
    { "name": "cue_location", "中文名称": "提示位置", "type": "text" },
    { "name": "habit_stacking", "中文名称": "习惯叠加", "type": "text" },
    { "name": "current_streak", "中文名称": "当前连续天数", "type": "number" },
    { "name": "best_streak", "中文名称": "历史最佳", "type": "number" },
    { "name": "total_checks", "中文名称": "总打卡次数", "type": "number" },
    { "name": "created_at", "中文名称": "创建时间", "type": "system_timestamp", "computed": true },
    { "name": "updated_at", "中文名称": "最后修改时间", "type": "system_timestamp", "computed": true }
  ]
}
