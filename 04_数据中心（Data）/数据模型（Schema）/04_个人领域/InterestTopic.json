    {"name": "knowledge_ref", "中文名称": "探索内容指针", "type": "text"},
    {"name": "last_explored_at", "中文名称": "最近探索", "type": "date"},
    {"name": "created_at", "中文名称": "创建时间", "type": "system_timestamp", "computed": true},
    {"name": "updated_at", "中文名称": "更新时间", "type": "system_timestamp", "computed": true}
