{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-os.local/schema/finance-monthly-snapshot/1.0",
  "title": "FinanceMonthlySnapshot",
  "description": "月度财务汇总快照；仅保存聚合数据，不保存逐笔流水。",
  "type": "object",
  "required": [
    "month",
    "currency",
    "total_income",
    "total_expenses",
    "balance",
    "savings_rate",
    "consumption_structure",
    "large_expenses",
    "month_over_month",
    "anomalies",
    "ai_analysis",
    "next_month_focus"
  ],
  "properties": {
    "month": {"type": "string", "pattern": "^(?!0000)[0-9]{4}-(0[1-9]|1[0-2])$"},
    "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "total_income": {"type": "number", "minimum": 0},
    "total_expenses": {"type": "number", "minimum": 0},
    "balance": {"type": "number"},
    "savings_rate": {"type": "number"},
    "consumption_structure": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "amount", "share"],
        "properties": {
          "category": {"type": "string", "minLength": 1},
          "amount": {"type": "number", "minimum": 0},
          "share": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "large_expenses": {
      "type": "array",
      "description": "大额支出的类别聚合，不包含单笔交易、商户、日期或流水明细。",
      "items": {
        "type": "object",
        "required": ["category", "amount", "share"],
        "properties": {
          "category": {"type": "string", "minLength": 1},
          "amount": {"type": "number", "minimum": 0},
          "share": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "month_over_month": {
      "type": "object",
      "required": [
        "income_change_percent",
        "expenses_change_percent",
        "balance_change_percent",
        "savings_rate_change_percentage_points"
      ],
      "properties": {
        "income_change_percent": {"type": ["number", "null"]},
        "expenses_change_percent": {"type": ["number", "null"]},
        "balance_change_percent": {"type": ["number", "null"]},
        "savings_rate_change_percentage_points": {"type": ["number", "null"]}
      },
      "additionalProperties": false
    },
    "anomalies": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "ai_analysis": {"type": "string", "minLength": 1, "maxLength": 4000},
    "next_month_focus": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
