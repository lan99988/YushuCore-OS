{
  "model": "ExperienceEvent",
  "中文名称": "人生体验事件",
  "version": "1.0",
  "description": "从愿望到反思的个人体验时间线索引。",
  "feishu_table": "Experience",
  "fields": [
    {"name": "experience_id", "中文名称": "体验ID", "type": "text", "required": true},
    {"name": "title", "中文名称": "体验", "type": "text", "required": true},
    {"name": "status", "中文名称": "状态", "type": "enum", "required": true, "options": ["wishlist", "planned", "booked", "experienced", "reflection"]},
    {"name": "scheduled_at", "中文名称": "计划时间", "type": "datetime"},
    {"name": "reflection_ref", "中文名称": "反思知识指针", "type": "text"},
    {"name": "created_at", "中文名称": "创建时间", "type": "system_timestamp", "computed": true},
    {"name": "updated_at", "中文名称": "更新时间", "type": "system_timestamp", "computed": true}
  ],
  "invariants": [
    "生命周期严格为 Wishlist → Planned → Booked → Experienced → Reflection",
    "Reflection 经用户确认后才能提出长期经验或原则候选",
    "反思正文只保存 Knowledge 指针"
  ]
}
