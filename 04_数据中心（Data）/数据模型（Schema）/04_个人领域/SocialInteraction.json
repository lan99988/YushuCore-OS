{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yushu.local/schemas/SocialInteraction.json",
  "title": "SocialInteraction",
  "description": "记录一次关系事件及从中识别的轻量上下文。",
  "type": "object",
  "properties": {
    "interaction_id": {"type": "string", "pattern": "^interaction-[a-f0-9]{12}$"},
    "person_id": {"type": "string", "pattern": "^person-[a-f0-9]{12}$"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "activity": {"type": "string", "minLength": 1, "maxLength": 120},
    "context": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 500},
      "maxItems": 20
    },
    "source_ref": {"type": "string", "minLength": 1, "maxLength": 200}
  },
  "required": ["interaction_id", "person_id", "occurred_at", "activity", "context"],
  "additionalProperties": false
}
