{
  "model": "CreationItem",
  "中文名称": "创作对象",
  "version": "1.0",
  "description": "创作执行态最小索引；长正文只通过 Knowledge 指针引用。",
  "feishu_table": "Creation",
  "fields": [
    {"name": "creation_id", "中文名称": "创作ID", "type": "text", "required": true},
    {"name": "title", "中文名称": "标题", "type": "text", "required": true},
    {"name": "status", "中文名称": "状态", "type": "enum", "required": true, "options": ["idea", "draft", "production", "publish", "feedback", "archive"]},
    {"name": "knowledge_ref", "中文名称": "知识正文指针", "type": "text"},
    {"name": "feedback_summary", "中文名称": "反馈摘要", "type": "text"},
    {"name": "created_at", "中文名称": "创建时间", "type": "system_timestamp", "computed": true},
    {"name": "updated_at", "中文名称": "更新时间", "type": "system_timestamp", "computed": true}
  ],
  "invariants": [
    "生命周期严格为 Idea → Draft → Production → Publish → Feedback → Archive",
    "长正文不得写入本模型，只保存 Knowledge 指针",
    "所有变化均先生成待审提案"
  ]
}
