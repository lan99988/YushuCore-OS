{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yushu.local/schemas/LifeAdminItem.json",
  "title": "LifeAdminItem",
  "description": "仅描述用户实际提及并激活的生活行政事项；不预建未涉及的对象。",
  "type": "object",
  "additionalProperties": false,
  "required": ["item_id", "title", "category", "subdomain", "status"],
  "properties": {
    "item_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "title": {"type": "string", "minLength": 1},
    "category": {
      "type": "string",
      "enum": [
        "identity_documents",
        "home_facilities",
        "personal_asset_maintenance",
        "services_contracts",
        "administrative_procedures"
      ]
    },
    "subdomain": {"type": "string", "minLength": 1, "maxLength": 80},
    "status": {"type": "string", "enum": ["active", "archived"]},
    "persisted": {"type": "boolean"},
    "expires_at": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])(-([0-2]\\d|3[01]))?$"
    }
  }
}
