{
  "model": "Idea",
  "中文名称": "灵感",
  "version": "1.0",
  "description": "灵感/想法暂存模型，记录突发想法并追踪其向任务或知识的转化。",
  "note": "v1.0 字段以飞书真实表「灵感库」为准；enum options 为初版，待与飞书实表对齐。",
  "source_skill": [
    "输入解析引擎"
  ],
  "feishu_table": {
    "id": "tblx1ZaQGwXvoJhj",
    "name": "灵感库"
  },
  "fields": [
    { "name": "title", "中文名称": "标题", "type": "text", "required": true },
    { "name": "project", "中文名称": "所属项目", "type": "enum", "options": ["考研", "项目A", "项目B", "项目C", "项目D", "生活区", "全局", "考试"] },
    { "name": "priority", "中文名称": "轻重缓急", "type": "enum", "options": ["重要紧急", "重要不紧急", "紧急不重要", "不重要不紧急"] },
    { "name": "status", "中文名称": "状态", "type": "enum", "options": ["待孵化", "孵化中", "已转化", "已放弃"] },
    { "name": "conversion_status", "中文名称": "转化状态", "type": "enum", "options": ["未转化", "已转任务", "已转知识", "已归档"] },
    { "name": "priority_prediction", "中文名称": "优先级预判", "type": "enum", "options": ["高", "中", "低"] },
    { "name": "idea_text", "中文名称": "灵感原文", "type": "text" },
    { "name": "trigger_scene", "中文名称": "触发场景", "type": "text" },
    { "name": "related_doc", "中文名称": "关联知识库文档", "type": "text" },
    { "name": "weight_score", "中文名称": "权重分", "type": "formula", "computed": true },
    { "name": "id", "中文名称": "ID", "type": "auto_number", "computed": true },
    { "name": "created_at", "中文名称": "创建时间", "type": "system_timestamp", "computed": true },
    { "name": "updated_at", "中文名称": "最后修改时间", "type": "system_timestamp", "computed": true }
  ]
}
