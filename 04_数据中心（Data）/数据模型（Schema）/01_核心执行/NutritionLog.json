{
  "model": "NutritionLog",
  "中文名称": "营养记录",
  "version": "1.0",
  "description": "Body OS 营养记录模型。Phase 1 只追踪蛋白质、饮水与补剂执行，降低每日输入负担。",
  "note": "Phase 1 设计稿：飞书 Base 表待创建；不做完整饮食热量系统。",
  "source_skill": [
    "yushu_10_身体总管_BodyController",
    "yushu_12_营养管理_NutritionSystem",
    "yushu_14_身体分析_BodyAnalytics"
  ],
  "feishu_table": null,
  "fields": [
    { "name": "date", "中文名称": "日期", "type": "datetime", "required": true },
    { "name": "protein_g", "中文名称": "蛋白质克数", "type": "number", "required": true },
    { "name": "water_ml", "中文名称": "饮水毫升", "type": "number" },
    { "name": "supplements", "中文名称": "补剂", "type": "text", "note": "例如：肌酸5g/鱼油/维D" },
    { "name": "adherence", "中文名称": "执行度", "type": "enum", "options": ["hit", "partial", "miss"] },
    { "name": "source", "中文名称": "来源", "type": "enum", "options": ["manual", "import"] },
    { "name": "notes", "中文名称": "备注", "type": "text" },
    { "name": "created_at", "中文名称": "创建时间", "type": "system_timestamp", "computed": true },
    { "name": "updated_at", "中文名称": "最后修改时间", "type": "system_timestamp", "computed": true }
  ]
}
