{
  "model": "Task",
  "中文名称": "任务",
  "version": "1.0",
  "description": "个人任务管理核心模型，承载日常任务与考研任务的执行、排程与追踪。",
  "note": "v1.0 字段以飞书真实表「执行库」为准；enum options 为初版，待与飞书实表对齐。",
  "source_skill": [
    "输入解析引擎",
    "随手录-飞书操作",
    "每日排程算法"
  ],
  "feishu_table": {
    "id": "tblNQCB4pn6Rso4a",
    "name": "执行库"
  },
  "fields": [
    { "name": "title", "中文名称": "标题", "type": "text", "required": true },
    { "name": "project", "中文名称": "所属项目", "type": "enum", "options": ["考研", "项目A", "项目B", "项目C", "项目D", "生活区", "全局", "考试"] },
    { "name": "priority", "中文名称": "轻重缓急", "type": "enum", "options": ["重要紧急", "重要不紧急", "紧急不重要", "不重要不紧急"] },
    { "name": "status", "中文名称": "状态", "type": "enum", "options": ["待处理", "进行中", "已完成", "已取消"] },
    { "name": "energy_level", "中文名称": "精力消耗等级", "type": "enum", "options": ["高", "中", "低"] },
    { "name": "is_hard_bone", "中文名称": "是否为今日硬骨头", "type": "boolean" },
    { "name": "subject_category", "中文名称": "科目类别", "type": "enum", "options": ["数学", "英语", "政治", "专业课", "无"] },
    { "name": "estimated_duration", "中文名称": "预估耗时", "type": "number" },
    { "name": "deadline", "中文名称": "截止日期", "type": "datetime" },
    { "name": "date", "中文名称": "日期", "type": "datetime", "note": "排程/计划日期" },
    { "name": "attachment", "中文名称": "附件", "type": "attachment" },
    { "name": "task_guid", "中文名称": "任务GUID", "type": "text", "note": "系统生成的唯一标识，用于跨表关联" },
    { "name": "related_doc", "中文名称": "关联知识库文档", "type": "text" },
    { "name": "owner", "中文名称": "责任人", "type": "enum", "options": [], "note": "待与飞书实表选项对齐" },
    { "name": "weight_score", "中文名称": "权重分", "type": "formula", "computed": true },
    { "name": "recommended_slot", "中文名称": "推荐时段", "type": "formula", "computed": true },
    { "name": "created_at", "中文名称": "创建时间", "type": "system_timestamp", "computed": true },
    { "name": "updated_at", "中文名称": "最后修改时间", "type": "system_timestamp", "computed": true }
  ]
}
