{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-ai-os.local/schema/knowledge-node/1.0",
  "title": "Personal Knowledge OS Knowledge Node",
  "description": "Versioned metadata contract for Markdown-derived Knowledge Nodes.",
  "type": "object",
  "required": [
    "id",
    "type",
    "domain",
    "source",
    "confidence",
    "status",
    "agent_access",
    "created",
    "updated"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "type": {
      "type": "string",
      "enum": [
        "knowledge",
        "principle",
        "model",
        "experience",
        "decision",
        "project",
        "agent_memory",
        "self_model",
        "decision_history"
      ]
    },
    "title": {"type": "string", "minLength": 1},
    "domain": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "layer": {
      "oneOf": [
        {"type": "integer", "minimum": 0, "maximum": 4},
        {
          "type": "string",
          "enum": ["raw", "knowledge", "cognition", "agent_intelligence", "self_model"]
        }
      ]
    },
    "source": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "author": {"type": "string"},
    "created": {"type": "string", "format": "date"},
    "updated": {"type": "string", "format": "date"},
    "status": {
      "type": "string",
      "enum": ["raw", "candidate", "reviewed", "validated", "permanent", "archived"]
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "importance": {"type": "number", "minimum": 0, "maximum": 1},
    "tags": {"type": "array", "items": {"type": "string"}},
    "relations": {
      "type": "array",
      "items": {"oneOf": [{"type": "string"}, {"type": "object"}]}
    },
    "agent_access": {"type": "array", "items": {"type": "string"}},
    "attachments": {"type": "array", "items": {"type": "string"}},
    "embedding": {"type": ["array", "object", "null"]},
    "sensitivity": {
      "type": "string",
      "enum": ["level_0", "level_1", "level_2", "level_3", "level_4"]
    },
    "version": {"type": "string", "minLength": 1}
    ,
    "decision_status": {"type": "string"},
    "decision_date": {"type": "string"},
    "review_date": {"type": ["string", "null"]},
    "agent": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
